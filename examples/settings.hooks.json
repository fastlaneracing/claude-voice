{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python -I <REPO>/scripts/voice_session_start.py" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python -I <REPO>/scripts/stop_backend.py" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python -I <REPO>/scripts/speak.py *)",
      "PowerShell(python -I <REPO>\\scripts\\speak.py *)"
    ]
  }
}
